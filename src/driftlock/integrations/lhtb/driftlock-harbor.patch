+@pytest.mark.asyncio
+async def test_litellm_chat_output_length_error_retains_response(monkeypatch):
+    async def fake_acompletion(**kwargs):
+        class Completion(dict):
+            pass
+
+        response = Completion({
+            "model": "provider-model",
+            "choices": [
+                {
+                    "message": {
+                        "content": "partial chat output",
+                        "reasoning_content": None,
+                    },
+                    "finish_reason": "length",
+                }
+            ],
+        })
+        response.usage = SimpleNamespace(prompt_tokens=13, completion_tokens=8)
+        return response
+
+    monkeypatch.setattr("litellm.acompletion", fake_acompletion)
+    llm = LiteLLM(model_name="fake-provider/fake-model")
+
+    with pytest.raises(OutputLengthExceededError) as exc_info:
+        await llm.call(prompt="hello", message_history=[])
+
+    assert exc_info.value.truncated_response == "partial chat output"
+    assert exc_info.value.response is not None
+    assert exc_info.value.response.content == "partial chat output"
+    assert exc_info.value.response.model_name == "provider-model"
+    assert exc_info.value.response.usage is not None
+    assert exc_info.value.response.usage.prompt_tokens == 13
+    assert exc_info.value.response.usage.completion_tokens == 8
+    assert llm._driftlock_provider_call_count == 1
+
+
+@pytest.mark.asyncio
+async def test_driftlock_single_attempt_disables_parameter_fallback(monkeypatch):
+    calls = 0
+
+    async def fake_acompletion(**kwargs):
+        nonlocal calls
+        calls += 1
+        raise LiteLLMBadRequestError(
+            message="Unrecognized request argument: session_id",
+            model="fake-model",
+            llm_provider="openai",
+        )
+
+    monkeypatch.setattr("litellm.acompletion", fake_acompletion)
+    llm = LiteLLM(model_name="openai/fake-model", session_id="session")
+    llm._driftlock_single_attempt = True
+
+    with pytest.raises(LiteLLMBadRequestError):
+        await llm.call.__wrapped__(llm, prompt="hello", message_history=[])
+
+    assert calls == 1
+    assert llm._driftlock_provider_call_count == 1
 
 
