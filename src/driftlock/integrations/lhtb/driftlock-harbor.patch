+++ b/harbor/tests/unit/agents/terminus_2/test_driftlock_quiescence.py
@@ -0,0 +1,324 @@
+import os
+import pty
+import select
+import subprocess
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from harbor.agents.terminus_2.terminus_2 import Command, Terminus2
+from harbor.agents.terminus_2.tmux_session import TmuxSession
+
+
+class FakeSession:
+    def __init__(self, *, time_out_first: bool = False) -> None:
+        self.calls = []
+        self.time_out_first = time_out_first
+
+    async def send_keys(self, keys, **kwargs):
+        self.calls.append((keys, kwargs))
+        if self.time_out_first and len(self.calls) == 1:
+            raise TimeoutError
+
+    async def get_incremental_output(self):
+        return "terminal output"
+
+
+def agent_stub() -> Terminus2:
+    agent = object.__new__(Terminus2)
+    agent._limit_output_length = lambda value: value
+    agent._timeout_template = "timeout {timeout_sec}: {command}: {terminal_state}"
+    return agent
+
+
+@pytest.mark.asyncio
+async def test_execute_commands_waits_for_shell_completion_marker():
+    session = FakeSession()
+
+    timed_out, output = await agent_stub()._execute_commands(
+        [Command("sleep 10; echo late > /app/late\n", 0.1)],
+        session,
+    )
+
+    assert not timed_out
+    assert output == "terminal output"
+    assert session.calls == [
+        (
+            "sleep 10; echo late > /app/late\n",
+            {
+                "block": True,
+                "min_timeout_sec": 0.0,
+                "max_timeout_sec": 180.0,
+            },
+        )
+    ]
+
+
+@pytest.mark.asyncio
+async def test_execute_commands_preserves_interactive_batch_timing():
+    session = FakeSession()
+
+    await agent_stub()._execute_commands(
+        [
+            Command("python3 -q\n", 1.0),
+            Command("print('hello')\n", 2.0),
+            Command("exit()\n", 0.1),
+            Command("", 3.0),
+        ],
+        session,
+    )
+
+    assert session.calls == [
+        (
+            "python3 -q\n",
+            {"block": False, "min_timeout_sec": 1.0, "max_timeout_sec": 180.0},
+        ),
+        (
+            "print('hello')\n",
+            {"block": False, "min_timeout_sec": 2.0, "max_timeout_sec": 180.0},
+        ),
+        (
+            "exit()\n",
+            {"block": True, "min_timeout_sec": 0.0, "max_timeout_sec": 180.0},
+        ),
+        (
+            "",
+            {"block": False, "min_timeout_sec": 3.0, "max_timeout_sec": 180.0},
+        ),
+    ]
+
+
+@pytest.mark.asyncio
+async def test_execute_commands_rejects_partial_final_key_before_sending_anything():
+    session = FakeSession()
+
+    with pytest.raises(ValueError, match="final non-empty command"):
+        await agent_stub()._execute_commands(
+            [
+                Command("touch /app/should-not-exist\n", 0.1),
+                Command("printf PARTIAL", 0.1),
+            ],
+            session,
+        )
+
+    assert session.calls == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("control_key", ["C-c", "C-d"])
+async def test_execute_commands_accepts_shell_return_control_key(control_key):
+    session = FakeSession()
+
+    await agent_stub()._execute_commands(
+        [
+            Command("python3 -q\n", 1.0),
+            Command(control_key, 0.1),
+        ],
+        session,
+    )
+
+    assert session.calls[-1] == (
+        [control_key, ":", "Enter"],
+        {"block": True, "min_timeout_sec": 0.0, "max_timeout_sec": 180.0},
+    )
+
+
+@pytest.mark.asyncio
+async def test_execute_commands_quiesces_a_timed_out_foreground_job():
+    session = FakeSession(time_out_first=True)
+
+    timed_out, output = await agent_stub()._execute_commands(
+        [Command("sleep 999\n", 0.1)],
+        session,
+    )
+
+    assert timed_out
+    assert "terminal output" in output
+    assert session.calls[1:] == [
+        (["C-c"], {"block": False, "min_timeout_sec": 0.1}),
+        ([":", "Enter"], {"block": True, "max_timeout_sec": 10.0}),
+    ]
+
+
+def tmux_session_stub() -> TmuxSession:
+    session = object.__new__(TmuxSession)
+    return session
+
+
+def test_blocking_keys_preserve_heredoc_terminator():
+    command = "cat <<'EOF'\nhello\nEOF\n"
+
+    prepared, completion_channel = tmux_session_stub()._prepare_keys(
+        command, block=True
+    )
+
+    assert completion_channel is not None
+    assert prepared[0] == command
+    assert prepared[1:] == [
+        TmuxSession._TMUX_COMPLETION_COMMAND.format(
+            completion_channel=completion_channel
+        ),
+        "Enter",
+    ]
+    assert "EOF;" not in "".join(prepared)
+
+
+@pytest.mark.parametrize("control_key", ["C-c", "C-d"])
+def test_blocking_keys_reject_unverified_shell_return_control_key(control_key):
+    with pytest.raises(ValueError, match="shell command boundary"):
+        tmux_session_stub()._prepare_keys(control_key, block=True)
+
+
+def test_completion_marker_restores_original_exit_status():
+    marker_without_tmux = TmuxSession._TMUX_COMPLETION_COMMAND.format(
+        completion_channel="test-channel"
+    ).replace("tmux wait -S test-channel", ":")
+    script = "false\n" + marker_without_tmux + "\nprintf '%s' $?\n"
+
+    result = subprocess.run(
+        ["bash", "--noprofile", "--norc"],
+        input=script,
+        text=True,
+        capture_output=True,
+        check=True,
+    )
+
+    assert result.stdout == "1"
+
+
+def test_completion_marker_does_not_touch_task_variables():
+    marker_without_tmux = TmuxSession._TMUX_COMPLETION_COMMAND.format(
+        completion_channel="test-channel"
+    ).replace("tmux wait -S test-channel", ":")
+    script = (
+        "readonly __driftlock_status=99\n"
+        "true\n"
+        + marker_without_tmux
+        + '\nprintf \'%s:%s\' "$?" "$__driftlock_status"\n'
+    )
+
+    result = subprocess.run(
+        ["bash", "--noprofile", "--norc"],
+        input=script,
+        text=True,
+        capture_output=True,
+        check=True,
+    )
+
+    assert result.stdout == "0:99"
+
+
+def test_completion_marker_runs_after_interactive_program_exits():
+    pid, descriptor = pty.fork()
+    if pid == 0:
+        os.execvp("bash", ["bash", "--noprofile", "--norc"])
+
+    output = bytearray()
+
+    def read_available(duration: float) -> None:
+        deadline = time.monotonic() + duration
+        while time.monotonic() < deadline:
+            readable, _, _ = select.select([descriptor], [], [], 0.05)
+            if readable:
+                output.extend(os.read(descriptor, 65_536))
+
+    try:
+        read_available(0.1)
+        os.write(descriptor, b"python3 -q\n")
+        read_available(0.1)
+        os.write(descriptor, b"print('hello')\n")
+        read_available(0.1)
+        marker = TmuxSession._TMUX_COMPLETION_COMMAND.format(
+            completion_channel="test-channel"
+        ).replace("tmux wait -S test-channel", "echo DRIFTLOCK_MARKER")
+        os.write(descriptor, f"exit()\n{marker}\n".encode())
+        read_available(1.0)
+
+        assert b"DRIFTLOCK_MARKER" in output
+        assert b"SyntaxError" not in output
+    finally:
+        os.write(descriptor, b"exit\n")
+        os.close(descriptor)
+        os.waitpid(pid, 0)
+
+
+def test_control_key_boundary_marker_runs_after_shell_noop():
+    pid, descriptor = pty.fork()
+    if pid == 0:
+        os.execvp("bash", ["bash", "--noprofile", "--norc"])
+
+    output = bytearray()
+
+    def read_available(duration: float) -> None:
+        deadline = time.monotonic() + duration
+        while time.monotonic() < deadline:
+            readable, _, _ = select.select([descriptor], [], [], 0.05)
+            if readable:
+                output.extend(os.read(descriptor, 65_536))
+
+    try:
+        read_available(0.1)
+        os.write(descriptor, b"sleep 10\n")
+        read_available(0.1)
+        os.write(descriptor, b"\x03")
+        read_available(0.1)
+        marker = TmuxSession._TMUX_COMPLETION_COMMAND.format(
+            completion_channel="test-channel"
+        ).replace("tmux wait -S test-channel", "echo DRIFTLOCK_MARKER")
+        os.write(descriptor, f":\n{marker}\n".encode())
+        read_available(1.0)
+
+        assert b"DRIFTLOCK_MARKER" in output
+    finally:
