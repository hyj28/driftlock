+def test_blocking_keys_use_a_fresh_channel_not_command_controlled_name(monkeypatch):
+    tokens = iter(["a" * 64, "b" * 64])
+    monkeypatch.setattr("secrets.token_hex", lambda size: next(tokens))
+    session = tmux_session_stub()
+
+    first, first_channel = session._prepare_keys(
+        "tmux wait -S done; printf first\n", block=True
+    )
+    second, second_channel = session._prepare_keys("printf second\n", block=True)
+
+    assert first_channel == f"driftlock-{'a' * 64}"
+    assert second_channel == f"driftlock-{'b' * 64}"
+    assert first_channel != second_channel
+    assert f"tmux wait -S {first_channel}" in first[-2]
+    assert f"tmux wait -S {second_channel}" in second[-2]
+    assert "tmux wait -S done" not in first[-2]
